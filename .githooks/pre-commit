#!/bin/sh
# Keeps generated files in step with their sources. Enable once per clone:
#   git config core.hooksPath .githooks
#
# - The component count on index.html (tools/count-components.js).
# - tokens.json (tools/export-tokens.js), exported from the staged sources.
set -e
root=$(git rev-parse --show-toplevel)

# ---- component count on index.html ------------------------------------------
# Unstaged edits in index.html would be swept into the commit by the git add
# below, so leave the file alone then and only check it.
index="$root/index.html"
if ! git diff --quiet -- "$index"; then
  node "$root/tools/count-components.js" --staged --check || {
    echo "pre-commit: stage or stash your index.html edits, then commit again."
    exit 1
  }
else
  node "$root/tools/count-components.js" --staged
  if ! git diff --quiet -- "$index"; then
    git add "$index"
  fi
fi

# ---- tokens.json --------------------------------------------------------------
# Export from what is staged, not from the working tree, so unstaged CSS edits
# never leak into the commit: copy the staged sources to a temp dir and run the
# exporter there. Unstaged edits in tokens.json itself: only check, as above.
tokens="$root/tokens.json"
if ! git diff --quiet -- "$tokens"; then
  echo "pre-commit: tokens.json has unstaged edits; it is generated (node tools/export-tokens.js). Stage or discard them, then commit again."
  exit 1
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git checkout-index --prefix="$tmp/" -- index.html shared/tokens.css shared/themes.css $(git ls-files -- components)
node "$root/tools/export-tokens.js" --root "$tmp" >/dev/null
if ! cmp -s "$tmp/tokens.json" "$tokens"; then
  cp "$tmp/tokens.json" "$tokens"
  git add "$tokens"
  echo "pre-commit: tokens.json updated from the staged sources."
fi

# ---- custom-elements.json -----------------------------------------------------
# Generated from the component headers (tools/manifest.js). Checked, not
# rewritten: a header edit means the manifest is regenerated on purpose.
node "$root/tools/manifest.js" --check >/dev/null || {
  echo "pre-commit: custom-elements.json is out of date. Run node tools/manifest.js and stage it."
  exit 1
}
